# ===== .htaccess หลัก — URL อ่านง่าย + ความปลอดภัยพื้นฐาน =====
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
# หมายเหตุ: ถ้าติดตั้งในโฟลเดอร์ย่อย (เช่น /mou-system) ให้ตั้ง RewriteBase ให้ตรง
RewriteBase /mou-system/

RewriteRule ^$                         public/index.php          [L,QSA]
RewriteRule ^mou/?$                    public/mou_list.php       [L,QSA]
RewriteRule ^mou/([0-9]+)/?$           public/mou_detail.php?id=$1 [L,QSA]
RewriteRule ^news/?$                   public/news_list.php      [L,QSA]
RewriteRule ^news/([0-9]+)/?$          public/news_detail.php?id=$1 [L,QSA]
RewriteRule ^contact/?$                public/contact.php        [L,QSA]
RewriteRule ^download/([0-9]+)/?$      public/download.php?id=$1 [L,QSA]
</IfModule>

# ซ่อนไฟล์สำคัญ
<FilesMatch "(^\.|\.(sql|log|md|ini|bak|sh|bat)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# บีบอัด + แคชไฟล์ static
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # CSS/JS มี ?v=เวลาแก้ไขไฟล์ ต่อท้ายอยู่แล้ว (includes/ui.php: asset()) จึงแคชได้นาน
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
